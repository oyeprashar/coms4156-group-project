{
  "info": {
    "name": "Ticketing Service",
    "description": "Manual tests for the ticketing service. Start PostgreSQL, load seed.sql, and run ./gradlew bootRun first. Run the requests in order: Reserve saves the reservation ID that Confirm and Cancel use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "eventId", "value": "evt_001" },
    { "key": "customerId", "value": "cust_postman" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "Search all upcoming events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/events"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('has events and count', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.events).to.be.an('array');",
                  "  pm.expect(body.count).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search with filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/events?city=New York&category=concert&minPrice=50&maxPrice=250&page=0&pageSize=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"],
              "query": [
                { "key": "city", "value": "New York" },
                { "key": "category", "value": "concert" },
                { "key": "minPrice", "value": "50" },
                { "key": "maxPrice", "value": "250" },
                { "key": "page", "value": "0" },
                { "key": "pageSize", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Invalid price range returns 400",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/events?minPrice=300&maxPrice=100",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"],
              "query": [
                { "key": "minPrice", "value": "300" },
                { "key": "maxPrice", "value": "100" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('returns 400', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Reserve tickets",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 2,\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('reservation is held', () => pm.expect(body.status).to.eql('HELD'));",
                  "pm.collectionVariables.set('reservationId', body.reservationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations/{{reservationId}}/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"paymentReference\": \"PAY_POSTMAN\",\n  \"idempotencyKey\": \"{{reservationId}}-confirm\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('issues one ticket per seat', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('CONFIRMED');",
                  "  pm.expect(body.tickets).to.have.lengthOf(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry confirm with same key returns same tickets",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations/{{reservationId}}/confirm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"paymentReference\": \"PAY_POSTMAN\",\n  \"idempotencyKey\": \"{{reservationId}}-confirm\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('returns 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Cancel confirmed reservation returns 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations/{{reservationId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 409', () => pm.response.to.have.status(409));",
                  "pm.test('error is RESERVATION_ALREADY_CONFIRMED', () =>",
                  "  pm.expect(pm.response.json().error).to.eql('RESERVATION_ALREADY_CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve then cancel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1,\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('reservationId', pm.response.json().reservationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel held reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations/{{reservationId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('reservation is cancelled', () =>",
                  "  pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Overbooking returns 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"quantity\": 1000000,\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns 409', () => pm.response.to.have.status(409));",
                  "pm.test('error is INSUFFICIENT_AVAILABILITY', () =>",
                  "  pm.expect(pm.response.json().error).to.eql('INSUFFICIENT_AVAILABILITY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown reservation returns 404",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/v1/reservations/res_missing/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('returns 404', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
